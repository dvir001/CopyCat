# ── Discord application ────────────────────────────────────────────────────────
# Found at https://discord.com/developers/applications → your app
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Discord role ID whose members can run pk;admin commands
ADMIN_ROLE=

# Social embed proxy rules. Each rule requires a replacement host or resolver settings.
PluralKit__Bot__SocialLinkReplacers__X__SourceHosts=x.com,*.x.com,twitter.com,*.twitter.com
PluralKit__Bot__SocialLinkReplacers__X__ReplacementHost=fixupx.com
PluralKit__Bot__SocialLinkReplacers__Reddit__SourceHosts=reddit.com,*.reddit.com,redd.it
PluralKit__Bot__SocialLinkReplacers__Reddit__ReplacementHost=vxreddit.com
PluralKit__Bot__SocialLinkReplacers__Bluesky__SourceHosts=bsky.app,*.bsky.app
PluralKit__Bot__SocialLinkReplacers__Bluesky__ReplacementHost=bskx.app
PluralKit__Bot__SocialLinkReplacers__TwitchClips__SourceHosts=clips.twitch.tv
PluralKit__Bot__SocialLinkReplacers__TwitchClips__ReplacementHost=fxtwitch.seria.moe
PluralKit__Bot__SocialLinkReplacers__TwitchClips__PathPattern=^/([^/]+)
PluralKit__Bot__SocialLinkReplacers__TwitchClips__PathReplacement='/clip/$1'
PluralKit__Bot__SocialLinkReplacers__TwitchWebClips__SourceHosts=twitch.tv,*.twitch.tv
PluralKit__Bot__SocialLinkReplacers__TwitchWebClips__ReplacementHost=fxtwitch.seria.moe
PluralKit__Bot__SocialLinkReplacers__TwitchWebClips__PathPattern=^/[^/]+/clip/([^/]+)
PluralKit__Bot__SocialLinkReplacers__TwitchWebClips__PathReplacement='/clip/$1'
PluralKit__Bot__SocialLinkReplacers__Instagram__SourceHosts=instagram.com,*.instagram.com,instagr.am
PluralKit__Bot__SocialLinkReplacers__Instagram__ReplacementHost=kirkstagram.com
PluralKit__Bot__SocialLinkReplacers__Pixiv__SourceHosts=pixiv.net,*.pixiv.net
PluralKit__Bot__SocialLinkReplacers__Pixiv__ReplacementHost=phixiv.net
PluralKit__Bot__SocialLinkReplacers__TikTok__SourceHosts=tiktok.com,*.tiktok.com
PluralKit__Bot__SocialLinkReplacers__TikTok__ReplacementHost=tnktok.com
PluralKit__Bot__SocialLinkReplacers__Tumblr__SourceHosts=tumblr.com,*.tumblr.com
PluralKit__Bot__SocialLinkReplacers__Tumblr__ReplacementHost=tpmblr.com
# No verified public replacement-domain service currently supports YouTube community posts.
PluralKit__Bot__SocialLinkReplacers__YouTubePosts__SourceHosts=youtube.com,*.youtube.com
PluralKit__Bot__SocialLinkReplacers__YouTubePosts__PathPattern=^/post/
PluralKit__Bot__SocialLinkReplacers__YouTubePosts__ReplacementHost=
PluralKit__Bot__SocialLinkReplacers__Facebook__SourceHosts=facebook.com,*.facebook.com,fb.com,*.fb.com,fb.watch
PluralKit__Bot__SocialLinkReplacers__Facebook__ReplacementHost=facebed.com
PluralKit__Bot__SocialLinkReplacers__Threads__SourceHosts=threads.net,*.threads.net,threads.com,*.threads.com
PluralKit__Bot__SocialLinkReplacers__Threads__ReplacementHost=fixthreads.seria.moe
PluralKit__Bot__SocialLinkReplacers__OnlyFans__SourceHosts=onlyfans.com,*.onlyfans.com
PluralKit__Bot__SocialLinkReplacers__OnlyFans__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__OnlyFans__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__Fansly__SourceHosts=fansly.com,*.fansly.com
PluralKit__Bot__SocialLinkReplacers__Fansly__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__Fansly__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__SpotifyTracks__SourceHosts=open.spotify.com
PluralKit__Bot__SocialLinkReplacers__SpotifyTracks__PathPattern=^/(?:intl-[^/]+/)?track/
PluralKit__Bot__SocialLinkReplacers__SpotifyTracks__ReplacementHost=fxspotify.com
PluralKit__Bot__SocialLinkReplacers__Bilibili__SourceHosts=bilibili.com,www.bilibili.com,m.bilibili.com
PluralKit__Bot__SocialLinkReplacers__Bilibili__ReplacementHost=vxbilibili.com
PluralKit__Bot__SocialLinkReplacers__BilibiliShortLinks__SourceHosts=b23.tv,www.b23.tv
PluralKit__Bot__SocialLinkReplacers__BilibiliShortLinks__ReplacementHost=vxb23.tv
PluralKit__Bot__SocialLinkReplacers__Snapchat__SourceHosts=snapchat.com,*.snapchat.com
PluralKit__Bot__SocialLinkReplacers__Snapchat__PathPattern=^/(?:p/[^/]+/[^/]+(?:/[^/]+)?|spotlight/[^/]+|@[^/]+/spotlight/[^/]+)
PluralKit__Bot__SocialLinkReplacers__Snapchat__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__Snapchat__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__Pinterest__SourceHosts=pinterest.com,*.pinterest.com
PluralKit__Bot__SocialLinkReplacers__Pinterest__PathPattern=^/pin/[^/]+
PluralKit__Bot__SocialLinkReplacers__Pinterest__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__Pinterest__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__PinterestShortLinks__SourceHosts=pin.it,*.pin.it
PluralKit__Bot__SocialLinkReplacers__PinterestShortLinks__PathPattern=^/[^/]+
PluralKit__Bot__SocialLinkReplacers__PinterestShortLinks__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__PinterestShortLinks__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__Imgur__SourceHosts=imgur.com,www.imgur.com,m.imgur.com
PluralKit__Bot__SocialLinkReplacers__Imgur__PathPattern=^/(?:gallery/)?[^/]+/?$
PluralKit__Bot__SocialLinkReplacers__Imgur__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__Imgur__ResolvedUrlTemplate=https://embedez.com/embed/{key}
PluralKit__Bot__SocialLinkReplacers__DeviantArt__SourceHosts=deviantart.com,*.deviantart.com
PluralKit__Bot__SocialLinkReplacers__DeviantArt__PathPattern=^/[^/]+/(?:art|journal)/[^/]+
PluralKit__Bot__SocialLinkReplacers__DeviantArt__ReplacementHost=fixdeviantart.com
PluralKit__Bot__SocialLinkReplacers__FurAffinity__SourceHosts=furaffinity.net,*.furaffinity.net
PluralKit__Bot__SocialLinkReplacers__FurAffinity__PathPattern=^/view/[^/]+
PluralKit__Bot__SocialLinkReplacers__FurAffinity__ReplacementHost=xfuraffinity.net
PluralKit__Bot__SocialLinkReplacers__Newgrounds__SourceHosts=newgrounds.com,*.newgrounds.com
PluralKit__Bot__SocialLinkReplacers__Newgrounds__PathPattern=^/art/view/[^/]+/[^/]+
PluralKit__Bot__SocialLinkReplacers__Newgrounds__ReplacementHost=fixnewgrounds.com
PluralKit__Bot__SocialLinkReplacers__NewgroundsPortal__SourceHosts=newgrounds.com,*.newgrounds.com
PluralKit__Bot__SocialLinkReplacers__NewgroundsPortal__PathPattern=^/portal/view/[^/]+
PluralKit__Bot__SocialLinkReplacers__NewgroundsPortal__ResolverUrl=https://embedez.com/api/v1/providers/combined
PluralKit__Bot__SocialLinkReplacers__NewgroundsPortal__ResolvedUrlTemplate=https://embedez.com/embed/{key}

# ── Docker / GHCR ─────────────────────────────────────────────────────────────
# Your GitHub username or org — used to pull images from GHCR
# e.g. GHCR_OWNER=dvir001  →  ghcr.io/dvir001/copycat:latest
GHCR_OWNER=your_github_username_here
